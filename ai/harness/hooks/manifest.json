{
  "hooks": [
    {
      "id": "schedule-wakeup-guard",
      "event": "tool.before",
      "tools": ["wake.schedule"],
      "script": "hooks/schedule-wakeup-guard",
      "enforce": "block"
    },
    {
      "id": "send-message-guard",
      "event": "tool.before",
      "tools": ["message.send"],
      "script": "hooks/send-message-guard",
      "enforce": "block"
    },
    {
      "id": "review-dedup-guard",
      "event": "tool.before",
      "tools": ["agent.spawn"],
      "script": "hooks/review-dedup-guard",
      "enforce": "block"
    },
    {
      "id": "secret-read-guard",
      "event": "tool.before",
      "tools": ["shell", "file.read"],
      "script": "hooks/secret-read-guard",
      "enforce": "warn"
    },
    {
      "id": "secret-read-guard-grep",
      "event": "tool.before",
      "matcher": "Grep",
      "script": "hooks/secret-read-guard",
      "enforce": "warn"
    },
    {
      "id": "secret-read-guard-ctx",
      "event": "tool.before",
      "matcher": "mcp__plugin_context-mode_context-mode__ctx_(execute|index|batch)",
      "script": "hooks/secret-read-guard",
      "enforce": "warn"
    },
    {
      "id": "read-size-nudge",
      "event": "tool.before",
      "tools": ["file.read"],
      "script": "hooks/read-size-nudge",
      "enforce": "block"
    },
    {
      "id": "context-reset-nudge",
      "event": "prompt.submit",
      "script": "hooks/context-reset-nudge.py",
      "timeout": 15,
      "enforce": "warn"
    },
    {
      "id": "session-name-nudge",
      "event": "prompt.submit",
      "script": "hooks/session-name-nudge.py",
      "timeout": 10,
      "enforce": "warn"
    },
    {
      "id": "session-manifest-record",
      "event": "session.start",
      "matcher": "startup|resume",
      "script": "hooks/session-manifest-record.py",
      "timeout": 10,
      "enforce": "warn"
    },
    {
      "id": "hook-doctor",
      "event": "session.start",
      "matcher": "startup|resume",
      "script": "hooks/hook-doctor.py",
      "timeout": 10,
      "enforce": "warn"
    },
    {
      "id": "memory-index-lint",
      "event": "session.start",
      "matcher": "startup",
      "script": "hooks/memory-index-lint.py",
      "timeout": 10,
      "enforce": "warn"
    },
    {
      "id": "post-compact-reminder",
      "event": "compact",
      "script": "hooks/post-compact-reminder.sh",
      "timeout": 10,
      "enforce": "warn"
    },
    {
      "id": "long-command-nudge",
      "event": "tool.before",
      "tools": ["shell"],
      "script": "hooks/long-command-nudge.py",
      "timeout": 10,
      "enforce": "warn"
    },
    {
      "id": "ask-question-guard",
      "event": "tool.before",
      "tools": ["ask.user"],
      "script": "hooks/ask-question-guard.py",
      "timeout": 10,
      "enforce": "block"
    },
    {
      "id": "subagent-rules",
      "event": "subagent.start",
      "script": "hooks/subagent-rules.py",
      "timeout": 10,
      "enforce": "warn"
    }
  ]
}
