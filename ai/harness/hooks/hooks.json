{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/schedule-wakeup-guard\"",
            "type": "command"
          }
        ],
        "matcher": "ScheduleWakeup|CronCreate"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/send-message-guard\"",
            "type": "command"
          }
        ],
        "matcher": "SendMessage"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/review-dedup-guard\"",
            "type": "command"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/secret-read-guard\"",
            "type": "command"
          }
        ],
        "matcher": "Bash|Read"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/secret-read-guard\"",
            "type": "command"
          }
        ],
        "matcher": "Grep"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/read-size-nudge\"",
            "type": "command"
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/long-command-nudge.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/ask-question-guard.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-manifest-record.py\"",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hook-doctor.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/memory-index-lint.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/post-compact-reminder.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/context-reset-nudge.py\"",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-name-nudge.py\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
