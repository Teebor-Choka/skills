#!/usr/bin/env bash
# SessionStart hook. Reads the payload `cwd` (CLAUDE_PROJECT_DIR only when it is absent).
# For any git repository: index it into codebase-memory-mcp's knowledge graph in the background,
# and tell Claude to query that graph instead of exploring the tree by hand. A no-op outside a git
# work tree, or when codebase-memory-mcp isn't on PATH.
#
# The main checkout is the indexed unit (see repo-root), so the project is the same regardless of
# which subdir or linked worktree the session starts in, and the context names it exactly. Indexing is backgrounded so it never blocks the
# session; the directive is printed as SessionStart additionalContext.
set -euo pipefail

payload=$(cat 2>/dev/null || true)
dir=$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null || true)
dir="${dir:-${CLAUDE_PROJECT_DIR:-$PWD}}"

command -v codebase-memory-mcp >/dev/null 2>&1 || exit 0
here=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || exit 0
{ read -r repo; read -r project; } < <("$(dirname "$0")/repo-root" "$dir")

"$(dirname "$0")/index-bg" "$repo"
ctx="This repository is indexed into codebase-memory-mcp's knowledge graph as project \`$project\`; pass exactly that name as \`project\`. To find or understand ANY code — locating a symbol, definition, caller, call path, data flow, architecture, or change impact — call the codebase-memory-mcp tools FIRST (search_graph to locate, then trace_path, get_code_snippet, search_code, get_architecture, query_graph), never an opening grep/read sweep. Use grep and file reads only to open a file the graph pointed to, or when the graph provably cannot answer (non-code text, an unindexed path). The index may still be completing in the background at the very start of a fresh session."
if [ "$here" != "$repo" ]; then
  ctx="$ctx This session is in a linked worktree ($here); the graph indexes the main checkout ($repo), so read files changed on this branch directly."
fi
jq -nc --arg ctx "$ctx" '{hookSpecificOutput:{hookEventName:"SessionStart",additionalContext:$ctx}}'
