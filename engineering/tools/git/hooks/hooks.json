{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/git-guard\"",
            "type": "command"
          },
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pr-poll-reminder\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/git-guard\"",
            "type": "command"
          }
        ],
        "matcher": "EnterWorktree"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/worktree-path-guard\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ]
  }
}
