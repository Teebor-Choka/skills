{
  "document": {
    "dsl": "1.1.0",
    "namespace": "demo",
    "name": "unit-loop",
    "version": "0.1.0",
    "title": "One unit of work (example)",
    "summary": "An invented inner loop for tests: red, green, then an isolated review. Three rounds at most."
  },
  "input": {
    "schema": {
      "format": "json",
      "document": {
        "type": "object",
        "required": ["unit"]
      }
    }
  },
  "do": [
    {
      "cycle": {
        "for": {
          "each": "attempt",
          "in": [1, 2, 3]
        },
        "while": "${ $accepted[\"cycle/peer-review\"] != true }",
        "do": [
          {
            "red": {
              "run": {
                "shell": {
                  "command": "agent-run",
                  "arguments": []
                }
              },
              "metadata": {
                "org": {
                  "by": "model",
                  "role": "worker",
                  "brief": "briefs/red.md",
                  "metrics": ["tests-added"],
                  "acceptance": [
                    {
                      "rubric": "criteria/red.md",
                      "judge": "reviewer",
                      "sample": 0.2
                    }
                  ]
                }
              }
            }
          },
          {
            "red-proof": {
              "run": {
                "shell": {
                  "command": "run-tests",
                  "arguments": ["unit", "red"]
                }
              },
              "metadata": {
                "org": {
                  "by": "code",
                  "role": "ci",
                  "metrics": ["wrong-failures"],
                  "acceptance": [
                    {
                      "check": "fails-for-the-right-reason"
                    }
                  ]
                }
              }
            }
          },
          {
            "green": {
              "run": {
                "shell": {
                  "command": "agent-run",
                  "arguments": []
                }
              },
              "metadata": {
                "org": {
                  "by": "model",
                  "role": "worker",
                  "brief": "briefs/green.md",
                  "metrics": ["diff-size"],
                  "acceptance": [
                    {
                      "rubric": "criteria/green.md",
                      "judge": "reviewer",
                      "sample": 0.2
                    }
                  ]
                }
              }
            }
          },
          {
            "green-proof": {
              "run": {
                "shell": {
                  "command": "run-tests",
                  "arguments": ["unit", "green"]
                }
              },
              "metadata": {
                "org": {
                  "by": "code",
                  "role": "ci",
                  "metrics": ["rounds"],
                  "acceptance": [
                    {
                      "check": "suite-green"
                    },
                    {
                      "check": "tests-untouched"
                    }
                  ]
                }
              }
            }
          },
          {
            "peer-review": {
              "run": {
                "shell": {
                  "command": "agent-run",
                  "arguments": ["--isolated"]
                }
              },
              "metadata": {
                "org": {
                  "by": "model",
                  "role": "reviewer",
                  "brief": "briefs/peer-review.md",
                  "metrics": ["rounds", "review-findings"],
                  "acceptance": [
                    {
                      "rubric": "criteria/peer-review.md",
                      "judge": "lead"
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "out-of-rounds": {
        "if": "${ $accepted[\"cycle/peer-review\"] != true }",
        "raise": {
          "error": {
            "type": "https://example.org/errors/unit-not-accepted",
            "status": 409,
            "title": "Unit not accepted after three rounds"
          }
        },
        "metadata": {
          "org": {
            "to": "lead"
          }
        }
      }
    }
  ]
}
