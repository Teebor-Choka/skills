#!/usr/bin/env bash
# Index one repo into codebase-memory-mcp in the background. Usage: index-bg <repo-root>.
# Shared by code-graph-index (SessionStart) and code-graph-reindex (Stop), so both take the same per-repo lock.
#
# Lock: a directory under $HOME/.cache named by a hash of the repo path, holding the pid of the job.
# A lock is stale, and taken over, when its pid is dead or the lock is older than 6 hours.
# The job is fully detached (stdin, stdout and stderr), so the calling hook returns at once and never
# holds the harness's pipe open. The CLI argument is built with jq, so a path cannot inject JSON keys.
set -euo pipefail

repo="$1"
cache="$HOME/.cache"
mkdir -p "$cache"

digest() {
  if command -v sha1sum >/dev/null 2>&1; then sha1sum
  elif command -v shasum >/dev/null 2>&1; then shasum
  else cksum
  fi
}
key=$(printf '%s' "$repo" | digest | cut -c1-16 | tr -c 'A-Za-z0-9\n' '_')
lock="$cache/git-reindex.$key.lock"

stale() {
  local pid
  pid=$(cat "$lock/pid" 2>/dev/null || true)
  if [[ $pid =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  [ -n "$(find "$lock" -maxdepth 0 -mmin +360 2>/dev/null)" ]
}

if ! mkdir "$lock" 2>/dev/null; then
  stale || exit 0
  rm -rf "$lock"
  mkdir "$lock" 2>/dev/null || exit 0
fi

json=$(jq -nc --arg repo "$repo" '{repo_path:$repo}')
(
  me=$(sh -c 'echo $PPID')
  # release only a lock this job still owns (a takeover may have replaced it)
  trap '[ "$(cat "$lock/pid" 2>/dev/null)" = "$me" ] && rm -rf "$lock"' EXIT
  codebase-memory-mcp cli index_repository "$json" >>"$cache/codebase-memory-index.log" 2>&1
) >/dev/null 2>&1 </dev/null &
printf '%s' "$!" >"$lock/pid"
exit 0
