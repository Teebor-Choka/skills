#!/usr/bin/env sh
# Test double for `gh`, driven by FAKE_* env so each test states the forge state it simulates.
#   FAKE_PR_NUMBER     the PR number `pr view --json number` returns; empty ⇒ "no PR" (exit 1)
#   FAKE_CHECKS_EXIT   the exit code `pr checks` returns (0 green, 8 pending, 1 failed); default 0
#   FAKE_REVIEW        the string `pr view --json reviewDecision` returns (APPROVED, …); default ""
set -eu

case "$*" in
*"pr view"*number*)
  [ -n "${FAKE_PR_NUMBER:-}" ] || exit 1
  printf '%s\n' "$FAKE_PR_NUMBER"
  ;;
*"pr checks"*)
  exit "${FAKE_CHECKS_EXIT:-0}"
  ;;
*"pr view"*reviewDecision*)
  printf '%s\n' "${FAKE_REVIEW:-}"
  ;;
*)
  exit 0
  ;;
esac
