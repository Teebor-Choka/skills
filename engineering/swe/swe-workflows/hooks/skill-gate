#!/usr/bin/env python3
"""PreToolUse hook (file.edit): load the skill that owns a file type before editing it.

skill-gate.rules.json beside this script maps a path regex to a skill: [{"pattern": "...", "skill": "plugin:name"}].
The first edit of a matching file in an agent's context is denied once with "load <skill>"; the retry passes,
so a forgotten load costs one round trip, not a loop. That is one nudge per session, agent and skill by
design: after the denial every later edit passes, and a marker older than 24 hours is ignored (a new nudge).
No denial when the agent's own transcript already shows the skill loaded (the scan is skill_loaded.py, shared
with git-guard). Subagents are gated too: agent_id keys the marker and selects the subagent's own transcript.

Rules are plugin-contributed: a plugin that wants a gate ships this script, a copy of skill_loaded.py and its
own skill-gate.rules.json, so plugins install independently and no table names another plugin's skills.
Fails open on malformed input, a missing or broken rules file, or an unwritable marker.
Tests: hooks/tests/test_skill_gate.py.
"""
import json
import os
import re
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import skill_loaded  # noqa: E402

EDIT_TOOLS = {"Edit", "Write", "MultiEdit"}
RULES_FILE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "skill-gate.rules.json")


def safe(value):
    return re.sub(r"[^A-Za-z0-9_.-]", "_", str(value)).lstrip(".") or "none"


MARKER_TTL = 24 * 3600  # seconds; an older marker no longer silences the nudge


def fresh(marker):
    try:
        return time.time() - os.path.getmtime(marker) < MARKER_TTL
    except OSError:
        return False


def load_rules(path=RULES_FILE):
    """[(compiled regex, skill)] from the rules file. A bad row is skipped and noted on stderr; the rest
    stay in force. A missing or unparseable file gives []."""
    try:
        with open(path) as f:
            rows = json.load(f)
        if not isinstance(rows, list):
            raise ValueError("expected a list of rows")
    except (OSError, ValueError) as e:
        if not isinstance(e, FileNotFoundError):
            print(f"skill-gate: ignoring rules file {path}: {e}", file=sys.stderr)
        return []
    rules = []
    for i, row in enumerate(rows):
        try:
            if not isinstance(row["skill"], str):
                raise TypeError("skill must be a string")
            rules.append((re.compile(row["pattern"]), row["skill"]))
        except (KeyError, TypeError, re.error) as e:
            print(f"skill-gate: skipping rule #{i} in {path}: {e!r}", file=sys.stderr)
    return rules


def main():
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict) or payload.get("tool_name") not in EDIT_TOOLS:
            return
        path = (payload.get("tool_input") or {}).get("file_path")
        if not isinstance(path, str) or not path:
            return
    except Exception:
        return
    skill = next((s for rx, s in load_rules() if rx.search(path)), None)
    if not skill:
        return
    marker = os.path.join(os.environ.get("TMPDIR") or "/tmp", "agent-skill-gate-{}-{}-{}".format(
        safe(payload.get("session_id") or "nosession"), safe(payload.get("agent_id") or "main"), safe(skill)))
    if fresh(marker) or skill_loaded.skill_loaded(payload, skill) is True:
        return
    try:
        open(marker, "w").close()
    except OSError:
        return  # cannot remember the denial: fail open rather than deny every retry
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse", "permissionDecision": "deny",
        "permissionDecisionReason": f"Load {skill} with the Skill tool, then retry this edit."}}))


if __name__ == "__main__":
    main()
