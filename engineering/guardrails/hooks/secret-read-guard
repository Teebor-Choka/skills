#!/usr/bin/env python3
"""PreToolUse hook (tools: Bash, Read): ask before a call prints a secret into the transcript.

Secrets reach transcripts when an agent cats a key file, dumps the environment, echoes a token variable or
runs `security find-*-password -w`.
The hook asks (never denies) for:
  - cat/less/more/head/tail/bat/tac/nl/strings/xxd/od/grep/egrep/fgrep/rg/sed of a secret path (.env*, *.env,
    *.kdbx, *.pem, ~/.ssh/id_* but not .pub, talosconfig, kubeconfig, ~/.kube/config, credentials*,
    .netrc, .pgpass, ~/Library/Caches/*, plus any path matching AGENT_GUARDRAILS_SECRET_PATHS), and a Read
    of such a file;
  - env / printenv / set / export -p / declare -p with no filter, and printenv NAME for a secret-like NAME;
  - echo/printf of $NAME where NAME holds TOKEN, SECRET, PASSWORD, PASSWD, KEY or CREDENTIAL
    (names ending _FILE, _PATH, _DIR or _ID pass; ${#NAME} and ${NAME:+..} pass);
  - security find-*password with -w or -g, and keepassxc-cli show with -s or an attribute of Password.
A call is allowed when its output cannot reach the transcript: an output redirect (`> f`, not `2> f`), or a
later stage of the same pipeline that consumes it (pbcopy, wc, shasum family, kubectl, `grep -c/-l/-L/-q`,
`cut -f1`). `grep -l/-c/-L/-q` on a secret file lists names only and passes. Quoted text, heredoc bodies,
`bash -c`/`sh -c`/`eval` strings (analysed recursively, depth 3), `sudo`/`env VAR=x` wrappers are handled.
Command substitution is not exempted: `echo $(cat .env)` asks. A single-quoted `$NAME` also asks (conservative).
Not a security boundary: it catches accidents. Parsing is one linear pass; no backtracking regex on input.
AGENT_GUARDRAILS_SECRET_PATHS adds site-specific protected paths: os.pathsep-separated fnmatch globs
(`*` also matches `/`), `~` and `$HOME` expanded, e.g. `~/.config/vault/*/*:/srv/secrets/*`.
Any doubt or malformed input fails open. Tests: hooks/tests/test_secret_read_guard.py.
Schema: https://code.claude.com/docs/en/hooks.md
"""
import fnmatch
import json
import os
import sys

MAX_COMMAND = 100_000
MAX_DEPTH = 3
READERS = {"cat", "less", "more", "head", "tail", "bat", "tac", "nl", "strings", "xxd", "od", "sed",
           "grep", "egrep", "fgrep", "rg"}
GREPS = {"grep", "egrep", "fgrep", "rg"}
SHELLS = {"bash", "sh", "zsh", "dash", "ksh"}
WRAPPERS = {"sudo", "doas", "command", "time", "nohup", "exec", "builtin", "nice"}
SINKS = {"pbcopy", "wc", "shasum", "sha1sum", "sha256sum", "md5sum", "cksum", "kubectl"}
SECRET_WORDS = ("TOKEN", "SECRET", "PASSWORD", "PASSWD", "KEY", "CREDENTIAL")
NOT_SECRET_SUFFIXES = ("_FILE", "_PATH", "_DIR", "_ID")
TEMPLATE_SUFFIXES = (".example", ".sample", ".template", ".dist", ".defaults")
SECRET_BASENAMES = {"talosconfig", "kubeconfig", ".netrc", "_netrc", ".pgpass", ".git-credentials", "credentials"}
SECRET_EXTS = (".kdbx", ".pem", ".p12", ".pfx")

WHAT = {
    "file": "This command would print a secret-bearing file into the transcript.",
    "env": "This command would dump every environment variable, secrets included, into the transcript.",
    "var": "This command would print the value of a secret-like variable into the transcript.",
    "keychain": "This command would print a stored password into the transcript.",
}
ADVICE = (" Use a show-config helper that masks values if one is installed, or list names only: "
          "`grep -c PATTERN file`, `cut -d= -f1 file`, `ls`, `test -f`, `env | cut -d= -f1`. "
          "If a command needs the value, pipe it into its consumer (`| pbcopy`, `| kubectl ... --from-file=/dev/stdin`) "
          "or redirect it to a file.")


def strip_heredocs(text):
    """Drop heredoc bodies and the `<<WORD` marker; the body is data, not commands."""
    out, delim = [], None
    for line in text.split("\n"):
        if delim is not None:
            if line.strip() == delim:
                delim = None
            continue
        j = line.find("<<")
        while j != -1 and line.startswith("<<<", j):
            j = line.find("<<", j + 3)
        if j != -1:
            k = j + 2
            if line.startswith("-", k):
                k += 1
            while k < len(line) and line[k] in " \t":
                k += 1
            e = k
            while e < len(line) and line[e] not in " \t;|&<>()":
                e += 1
            word = line[k:e].strip("'\"\\")
            if word:
                delim = word
                line = line[:j] + " " + line[e:]
        out.append(line)
    return "\n".join(out)


def split_segments(text):
    """One pass. Returns [(tokens, sep_after, stdout_redirected)]; sep_after is "|" for a pipe, else ";"."""
    segs, toks, cur = [], [], []
    state = {"has": False, "out": False, "drop": False}

    def flush():
        if state["has"]:
            tok = "".join(cur)
            if state["drop"]:
                state["drop"] = False
            else:
                toks.append(tok)
        cur.clear()
        state["has"] = False

    def end(sep):
        flush()
        if toks:
            segs.append((list(toks), sep, state["out"]))
        toks.clear()
        state["out"] = False
        state["drop"] = False

    i, n, quote = 0, len(text), None
    while i < n:
        c = text[i]
        if quote == "'":
            if c == "'":
                quote = None
            else:
                cur.append(c)
        elif quote == '"':
            if c == '"':
                quote = None
            elif c == "\\" and i + 1 < n:
                i += 1
                cur.append(text[i])
            else:
                cur.append(c)
        elif c == "'" or c == '"':
            quote = c
            state["has"] = True
        elif c == "\\":
            if i + 1 < n:
                i += 1
                if text[i] != "\n":
                    cur.append(text[i])
                    state["has"] = True
        elif c in " \t\r<":
            flush()
        elif c == "#" and not state["has"]:
            while i < n and text[i] != "\n":
                i += 1
            continue
        elif c in "\n;`()":
            end(";")
        elif c == "|":
            if text.startswith("||", i):
                i += 1
                end(";")
            elif text.startswith("|&", i):
                i += 1
                end("|")
            else:
                end("|")
        elif c == "&" and not text.startswith("&>", i):
            if text.startswith("&&", i):
                i += 1
            end(";")
        elif c == ">" or c == "&":
            fd = "".join(cur) if state["has"] and "".join(cur).isdigit() else None
            if fd is not None:
                cur.clear()
                state["has"] = False
            else:
                flush()
            if c == "&":
                i += 1  # &> file
            while i + 1 < n and text[i + 1] == ">":
                i += 1
            if i + 1 < n and text[i + 1] == "&" and i + 2 < n and (text[i + 2].isdigit() or text[i + 2] == "-"):
                i += 2  # fd duplication such as 2>&1: no file involved
            else:
                if i + 1 < n and text[i + 1] in "&|":
                    i += 1
                state["drop"] = True
                if fd in (None, "1"):
                    state["out"] = True
        else:
            cur.append(c)
            state["has"] = True
        i += 1
    end(";")
    return segs


def is_assign(tok):
    name, eq, _ = tok.partition("=")
    return bool(eq) and name.isidentifier()


def command_of(toks):
    """(command basename, args) after wrappers and VAR=x prefixes. Bare `env` yields ("env", [])."""
    i = 0
    while i < len(toks):
        t = toks[i]
        if is_assign(t):
            i += 1
            continue
        base = t.rsplit("/", 1)[-1]
        if base in WRAPPERS:
            i += 1
            while i < len(toks) and toks[i].startswith("-"):
                i += 2 if base == "sudo" and toks[i] in ("-u", "-g") else 1
            continue
        if base == "env":
            i += 1
            while i < len(toks) and (toks[i].startswith("-") or is_assign(toks[i])):
                i += 1
            if i >= len(toks):
                return "env", []
            continue
        return base, toks[i + 1:]
    return "", []


def secret_name(name):
    upper = name.upper()
    return not upper.endswith(NOT_SECRET_SUFFIXES) and any(w in upper for w in SECRET_WORDS)


def has_secret_var(arg):
    i = arg.find("$")
    while i != -1:
        j = i + 1
        if arg.startswith("{", j):
            j += 1
            if arg.startswith("#", j):
                i = arg.find("$", j)
                continue
        start = j
        while j < len(arg) and (arg[j].isalnum() or arg[j] == "_"):
            j += 1
        if j > start and not arg.startswith(":+", j) and secret_name(arg[start:j]):
            return True
        i = arg.find("$", j if j > i else i + 1)
    return False


def extra_globs():
    home = os.path.expanduser("~")
    out = []
    for entry in os.environ.get("AGENT_GUARDRAILS_SECRET_PATHS", "").split(os.pathsep):
        entry = entry.strip()
        if entry.startswith("~/"):
            entry = home + entry[1:]
        entry = entry.replace("${HOME}", home).replace("$HOME", home)
        if entry:
            out.append(entry)
    return out


def secret_path(path):
    if not isinstance(path, str):
        return False
    p = path
    for home in ("${HOME}", "$HOME"):
        if p.startswith(home + "/"):
            p = "~" + p[len(home):]
    base = p.rsplit("/", 1)[-1]
    low = base.lower()
    if not low:
        return False
    full = "/" + p
    if low == ".env" or (low.startswith(".env.") and not low.endswith(TEMPLATE_SUFFIXES)):
        return True
    if low.endswith(".env") or low.endswith(SECRET_EXTS):
        return True
    if low.startswith("id_") and not low.endswith(".pub") and "/.ssh/" in full:
        return True
    if low in SECRET_BASENAMES or low.startswith("credentials.") or low.startswith("kubeconfig."):
        return True
    if full.endswith("/.kube/config") or "/Library/Caches/" in full:
        return True
    expanded = os.path.expanduser(p) if p.startswith("~/") else p
    return any(fnmatch.fnmatchcase(expanded, g) for g in extra_globs())


def listing_flags(args):
    """True when a grep-family call only lists files or counts matches."""
    for a in args:
        if a in ("--count", "--files-with-matches", "--files-without-match", "--quiet", "--silent"):
            return True
        if a.startswith("-") and not a.startswith("--") and a[1:].isalpha() and any(ch in "lcLq" for ch in a[1:]):
            return True
    return False


def has_short_flag(args, letters):
    return any(a.startswith("-") and not a.startswith("--") and a[1:].isalpha() and any(ch in letters for ch in a[1:])
               for a in args)


def is_sink(base, args):
    if base in SINKS:
        return True
    if base in GREPS:
        return listing_flags(args)
    if base == "cut":
        return "-f1" in args or any(a == "-f" and b == "1" for a, b in zip(args, args[1:]))
    return False


def reader_kind(base, args):
    if base == "sed" and has_short_flag(args, "i"):
        return ""
    if base in GREPS:
        if listing_flags(args):
            return ""
        pos, skip, has_pattern_flag = [], False, False
        for a in args:
            if skip:
                skip = False
            elif a in ("-e", "--regexp", "-f", "--file"):
                has_pattern_flag = skip = True
            elif not (a.startswith("-") and len(a) > 1):
                pos.append(a)
        args = pos if has_pattern_flag else pos[1:]
    return "file" if any(secret_path(a) for a in args if not a.startswith("-")) else ""


def kind_of(base, args, depth):
    if base in SHELLS:
        for k, a in enumerate(args):
            if a.startswith("-") and not a.startswith("--") and a[1:].isalpha() and "c" in a[1:]:
                return scan(args[k + 1], depth + 1) if k + 1 < len(args) else ""
        return ""
    if base == "eval":
        return scan(" ".join(args), depth + 1)
    if base == "env":
        return "env"
    if base == "printenv":
        names = [a for a in args if not a.startswith("-")]
        if not names:
            return "env"
        return "var" if any(secret_name(a) for a in names) else ""
    if base == "set":
        return "env" if not args else ""
    if base in ("export", "declare", "typeset"):
        return "env" if args == ["-p"] else ""
    if base in ("echo", "printf"):
        return "var" if any(has_secret_var(a) for a in args) else ""
    if base == "security":
        sub = next((a for a in args if a.startswith("find-")), "")
        if sub.endswith("password") and has_short_flag(args, "wg"):
            return "keychain"
        return ""
    if base == "keepassxc-cli":
        if "show" in args and ("--show-protected" in args or has_short_flag(args, "s")
                               or any(a in ("-a", "--attributes") and b.lower() == "password"
                                      for a, b in zip(args, args[1:]))):
            return "keychain"
        return ""
    if base in READERS:
        return reader_kind(base, args)
    return ""


def scan(text, depth=0):
    """The first kind of secret print found in the command text, else ""."""
    if depth > MAX_DEPTH or not isinstance(text, str):
        return ""
    segs = split_segments(strip_heredocs(text))
    for i, (toks, _, redirected) in enumerate(segs):
        base, args = command_of(toks)
        kind = kind_of(base, args, depth)
        if not kind or redirected:
            continue
        j, consumed = i, False
        while j + 1 < len(segs) and segs[j][1] == "|":
            j += 1
            if is_sink(*command_of(segs[j][0])):
                consumed = True
                break
        if not consumed:
            return kind
    return ""


def bash_reason(command):
    if not isinstance(command, str) or len(command) > MAX_COMMAND:
        return ""
    kind = scan(command)
    return WHAT[kind] + ADVICE if kind else ""


def read_reason(path):
    return WHAT["file"] + ADVICE if secret_path(path) else ""


def main():
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            return
        tool_input = payload.get("tool_input")
        if not isinstance(tool_input, dict):
            return
        tool = payload.get("tool_name")
        if tool == "Bash":
            reason = bash_reason(tool_input.get("command"))
        elif tool == "Read":
            reason = read_reason(tool_input.get("file_path"))
        else:
            return
    except Exception:
        return
    if reason:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse", "permissionDecision": "ask", "permissionDecisionReason": reason}}))


if __name__ == "__main__":
    main()
