{
  "owner": "teebor",
  "namespace": "org",
  "roles": {
    "lead": {
      "escalates-to": "owner",
      "may-spawn": ["worker", "reviewer", "tester", "ci", "architect", "pm"]
    },
    "pm": {
      "escalates-to": "lead"
    },
    "tester": {
      "escalates-to": "lead"
    },
    "ci": {
      "escalates-to": "lead"
    },
    "architect": {
      "escalates-to": "lead"
    },
    "reviewer": {
      "escalates-to": "lead"
    },
    "worker": {
      "escalates-to": "lead"
    },
    "improver": {
      "escalates-to": "owner",
      "rungs": ["free", "ordinary"]
    }
  },
  "workflows": {
    "sw-development": {
      "path": "workflows/sw-development.json",
      "floors": ["merge-gate"]
    },
    "tdd-unit": {
      "path": "workflows/tdd-unit.json",
      "floors": []
    },
    "improve": {
      "path": "workflows/improve.json",
      "floors": []
    }
  },
  "targets": {
    "spec-rework": {
      "at-most": 1,
      "per": "item"
    },
    "red-for-wrong-reason": {
      "at-most": 0,
      "per": "unit"
    },
    "acceptance-coverage": {
      "at-least": 1.0
    }
  },
  "vetoes": [
    "no merge without the merge-gate decision",
    "no node weakens a floor, a target or a criteria file"
  ],
  "checks": {
    "spec-check": "shape",
    "spec-coverage": "shape",
    "every-acceptance-test-fails-on-an-assertion": "fact",
    "write-sets-are-disjoint": "shape",
    "unit-verdict-is-pass": "shape",
    "acceptance-suite-green": "fact",
    "checks-green-and-gate-approved": "fact",
    "report-has-every-required-section": "shape",
    "every-proposal-is-within-its-rung": "shape",
    "red-evidence": "fact",
    "new-test-fails-on-an-assertion-not-a-compile-error": "fact",
    "green-evidence": "fact",
    "suite-green-and-no-test-edited": "fact",
    "suite-still-green-and-no-test-edited": "fact",
    "workers-done": "shape"
  }
}
