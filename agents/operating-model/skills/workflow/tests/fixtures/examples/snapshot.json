{
  "sw-development": {
    "do": [
      {
        "align": {
          "metadata": {
            "org": {
              "acceptance": [
                {
                  "judge": "lead",
                  "rubric": "criteria/sw/brief.md"
                }
              ],
              "brief": "briefs/sw/align.md",
              "by": "model",
              "metrics": ["escalations"],
              "role": "pm"
            }
          },
          "run": {
            "shell": {
              "arguments": [],
              "command": "agent-run"
            }
          }
        }
      },
      {
        "spec": {
          "metadata": {
            "org": {
              "acceptance": [
                {
                  "check": "spec-check"
                },
                {
                  "judge": "reviewer",
                  "rubric": "criteria/sw/spec.md"
                }
              ],
              "brief": "briefs/sw/spec.md",
              "by": "model",
              "floor": true,
              "metrics": ["spec-rework"],
              "role": "lead"
            }
          },
          "output": {
            "schema": {
              "format": "json",
              "resource": {
                "endpoint": "schemas/org/item.json"
              }
            }
          },
          "run": {
            "shell": {
              "arguments": [],
              "command": "agent-run"
            }
          }
        }
      },
      {
        "acceptance-tests": {
          "metadata": {
            "org": {
              "acceptance": [
                {
                  "check": "spec-coverage"
                },
                {
                  "judge": "reviewer",
                  "rubric": "criteria/sw/acceptance-tests.md"
                }
              ],
              "brief": "briefs/sw/acceptance-tests.md",
              "by": "model",
              "metrics": ["acceptance-coverage"],
              "role": "tester"
            }
          },
          "run": {
            "shell": {
              "arguments": [],
              "command": "agent-run"
            }
          }
        }
      },
      {
        "acceptance-red": {
          "metadata": {
            "org": {
              "acceptance": [
                {
                  "check": "every-acceptance-test-fails-on-an-assertion"
                }
              ],
              "by": "code",
              "metrics": ["red-for-wrong-reason"],
              "role": "ci"
            }
          },
          "run": {
            "shell": {
              "arguments": ["acceptance", "red"],
              "command": "tdd-evidence"
            }
          }
        }
      },
      {
        "design": {
          "metadata": {
            "org": {
              "acceptance": [
                {
                  "judge": "reviewer",
                  "rubric": "criteria/sw/design.md"
                }
              ],
              "brief": "briefs/sw/design.md",
              "by": "model",
              "metrics": ["escalations"],
              "role": "architect"
            }
          },
          "run": {
            "shell": {
              "arguments": [],
              "command": "agent-run"
            }
          }
        }
      },
      {
        "cut": {
          "export": {
            "as": "${ $context + . }"
          },
          "metadata": {
            "org": {
              "acceptance": [
                {
                  "check": "write-sets-are-disjoint"
                }
              ],
              "brief": "briefs/sw/cut.md",
              "by": "model",
              "metrics": ["write-set-collisions"],
              "role": "lead"
            }
          },
          "output": {
            "schema": {
              "format": "json",
              "resource": {
                "endpoint": "schemas/org/units.json"
              }
            }
          },
          "run": {
            "shell": {
              "arguments": [],
              "command": "agent-run"
            }
          }
        }
      },
      {
        "build": {
          "do": [
            {
              "units": {
                "do": [
                  {
                    "tdd": {
                      "metadata": {
                        "org": {
                          "acceptance": [
                            {
                              "check": "unit-verdict-is-pass"
                            }
                          ],
                          "by": "code",
                          "metrics": ["escalations"],
                          "role": "lead"
                        }
                      },
                      "run": {
                        "workflow": {
                          "input": {
                            "unit": "${ $unit }"
                          },
                          "name": "tdd-unit",
                          "namespace": "org",
                          "version": "0.2.0"
                        }
                      }
                    }
                  }
                ],
                "for": {
                  "each": "unit",
                  "in": "${ $context.units }"
                }
              }
            },
            {
              "acceptance-run": {
                "metadata": {
                  "org": {
                    "acceptance": [
                      {
                        "check": "acceptance-suite-green"
                      }
                    ],
                    "by": "code",
                    "metrics": ["acceptance-rounds"],
                    "role": "ci"
                  }
                },
                "run": {
                  "shell": {
                    "arguments": ["acceptance", "green"],
                    "command": "tdd-evidence"
                  }
                }
              }
            }
          ],
          "for": {
            "each": "round",
            "in": [1, 2]
          },
          "while": "${ $accepted[\"build/acceptance-run\"] != true }"
        }
      },
      {
        "not-accepted": {
          "if": "${ $accepted[\"build/acceptance-run\"] != true }",
          "metadata": {
            "org": {
              "to": "lead"
            }
          },
          "raise": {
            "error": {
              "status": 409,
              "title": "Acceptance suite still red after the round bound",
              "type": "https://org.example/errors/acceptance-not-met"
            }
          }
        }
      },
      {
        "review": {
          "metadata": {
            "org": {
              "acceptance": [
                {
                  "judge": "owner",
                  "rubric": "criteria/sw/review.md"
                }
              ],
              "brief": "briefs/sw/review.md",
              "by": "model",
              "floor": true,
              "metrics": ["defects-found-in-review", "defects-escaped"],
              "role": "reviewer"
            }
          },
          "run": {
            "shell": {
              "arguments": ["--isolated"],
              "command": "agent-run"
            }
          },
          "timeout": {
            "after": {
              "days": 7
            }
          }
        }
      },
      {
        "merge-gate": {
          "listen": {
            "to": {
              "one": {
                "with": {
                  "type": "org.owner-decided"
                }
              }
            }
          },
          "metadata": {
            "org": {
              "acceptance": [
                {
                  "human": "decision signed and verified"
                }
              ],
              "by": "human",
              "floor": true,
              "metrics": ["escalations", "decision-latency"],
              "role": "owner"
            }
          },
          "timeout": {
            "after": {
              "days": 2
            }
          }
        }
      },
      {
        "merge": {
          "if": "${ $accepted[\"merge-gate\"] == true }",
          "metadata": {
            "org": {
              "acceptance": [
                {
                  "check": "checks-green-and-gate-approved"
                }
              ],
              "by": "code",
              "metrics": ["lead-time"],
              "role": "ci"
            }
          },
          "run": {
            "shell": {
              "arguments": ["--into", "vcs.default-branch"],
              "command": "merge-change"
            }
          }
        }
      },
      {
        "report": {
          "emit": {
            "event": {
              "with": {
                "source": "sw-development",
                "type": "org.run-reported"
              }
            }
          },
          "metadata": {
            "org": {
              "acceptance": [
                {
                  "check": "report-has-every-required-section"
                }
              ],
              "by": "code",
              "metrics": ["report-complete"],
              "role": "ci"
            }
          }
        }
      },
      {
        "improve": {
          "metadata": {
            "org": {
              "acceptance": [
                {
                  "check": "every-proposal-is-within-its-rung"
                }
              ],
              "by": "model",
              "metrics": ["proposals-accepted"],
              "role": "improver"
            }
          },
          "run": {
            "workflow": {
              "input": {
                "run": "${ $workflow.id }"
              },
              "name": "improve",
              "namespace": "org",
              "version": "latest"
            }
          }
        }
      }
    ],
    "document": {
      "dsl": "1.1.0",
      "metadata": {
        "org": {
          "policy": [
            "work.tracker",
            "vcs.remote",
            "vcs.default-branch",
            "comms.channel",
            "report.sink"
          ]
        }
      },
      "name": "sw-development",
      "namespace": "org",
      "summary": "One work item from an idea to a merged, reported change. The inner cycle is tdd-unit.",
      "title": "Software development, outer cycle (ATDD)",
      "version": "0.2.0"
    },
    "schedule": {
      "on": {
        "one": {
          "with": {
            "type": "org.work-item-ready"
          }
        }
      }
    }
  },
  "tdd-unit": {
    "do": [
      {
        "cycle": {
          "do": [
            {
              "red": {
                "metadata": {
                  "org": {
                    "acceptance": [
                      {
                        "check": "red-evidence"
                      }
                    ],
                    "brief": "briefs/sw/red.md",
                    "by": "model",
                    "metrics": ["tests-per-unit"],
                    "role": "worker"
                  }
                },
                "run": {
                  "shell": {
                    "arguments": [],
                    "command": "agent-run"
                  }
                }
              }
            },
            {
              "red-evidence": {
                "metadata": {
                  "org": {
                    "acceptance": [
                      {
                        "check": "new-test-fails-on-an-assertion-not-a-compile-error"
                      }
                    ],
                    "by": "code",
                    "metrics": ["red-for-wrong-reason"],
                    "role": "ci"
                  }
                },
                "run": {
                  "shell": {
                    "arguments": ["unit", "red"],
                    "command": "tdd-evidence"
                  }
                }
              }
            },
            {
              "green": {
                "metadata": {
                  "org": {
                    "acceptance": [
                      {
                        "check": "green-evidence"
                      }
                    ],
                    "brief": "briefs/sw/green.md",
                    "by": "model",
                    "metrics": ["diff-lines"],
                    "role": "worker"
                  }
                },
                "run": {
                  "shell": {
                    "arguments": [],
                    "command": "agent-run"
                  }
                }
              }
            },
            {
              "green-evidence": {
                "metadata": {
                  "org": {
                    "acceptance": [
                      {
                        "check": "suite-green-and-no-test-edited"
                      }
                    ],
                    "by": "code",
                    "metrics": ["green-rounds"],
                    "role": "ci"
                  }
                },
                "run": {
                  "shell": {
                    "arguments": ["unit", "green"],
                    "command": "tdd-evidence"
                  }
                }
              }
            },
            {
              "refactor": {
                "metadata": {
                  "org": {
                    "acceptance": [
                      {
                        "check": "suite-still-green-and-no-test-edited"
                      }
                    ],
                    "brief": "briefs/sw/refactor.md",
                    "by": "model",
                    "metrics": ["diff-lines"],
                    "role": "worker"
                  }
                },
                "run": {
                  "shell": {
                    "arguments": [],
                    "command": "agent-run"
                  }
                }
              }
            },
            {
              "unit-review": {
                "metadata": {
                  "org": {
                    "acceptance": [
                      {
                        "judge": "lead",
                        "rubric": "criteria/sw/unit-review.md"
                      }
                    ],
                    "brief": "briefs/sw/unit-review.md",
                    "by": "model",
                    "metrics": ["review-rounds", "defects-found-in-review"],
                    "role": "reviewer"
                  }
                },
                "run": {
                  "shell": {
                    "arguments": ["--isolated"],
                    "command": "agent-run"
                  }
                }
              }
            }
          ],
          "for": {
            "each": "attempt",
            "in": [1, 2, 3]
          },
          "while": "${ $accepted[\"cycle/unit-review\"] != true }"
        }
      },
      {
        "exhausted": {
          "if": "${ $accepted[\"cycle/unit-review\"] != true }",
          "metadata": {
            "org": {
              "to": "lead"
            }
          },
          "raise": {
            "error": {
              "status": 409,
              "title": "Unit not accepted after three rounds",
              "type": "https://org.example/errors/unit-not-accepted"
            }
          }
        }
      }
    ],
    "document": {
      "dsl": "1.1.0",
      "name": "tdd-unit",
      "namespace": "org",
      "summary": "Red, green, refactor for one unit, then an isolated review. Three rounds at most.",
      "title": "One unit of work, inner cycle (TDD)",
      "version": "0.2.0"
    },
    "input": {
      "schema": {
        "document": {
          "required": ["unit"],
          "type": "object"
        },
        "format": "json"
      }
    }
  }
}
