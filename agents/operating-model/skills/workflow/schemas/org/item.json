{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work item specification",
  "type": "object",
  "required": [
    "title",
    "criteria",
    "valid_inputs",
    "expected_outputs",
    "failure_definition",
    "performance",
    "dependencies",
    "out_of_scope"
  ],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "valid_inputs": { "type": "string", "minLength": 1 },
    "expected_outputs": { "type": "string", "minLength": 1 },
    "failure_definition": { "type": "string", "minLength": 1 },
    "performance": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "string", "minLength": 1 },
    "out_of_scope": { "type": "string", "minLength": 1 }
  }
}
