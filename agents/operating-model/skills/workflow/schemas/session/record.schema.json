        },
        "is_sidechain": {
          "type": "boolean",
          "description": "The native line is from a sidechain (subagent) transcript."
        },
        "is_meta": {
          "type": "boolean",
          "description": "The native line is marked meta."
        },
        "tool_use_id": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "description": "Text. For tool_result, text blocks joined by newline, other block types become a placeholder."
        },
        "is_error": {
          "type": "boolean"
        }
      }
    },
    {
      "title": "system",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "harness",
        "session_id",
        "seq",
        "uuid",
        "parent_uuid",
        "timestamp",
        "kind",
        "block_index",
        "is_sidechain",
        "is_meta",
        "subtype",
        "content"
      ],
      "properties": {
