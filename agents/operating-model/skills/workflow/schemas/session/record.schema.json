          "description": "The native line is from a sidechain (subagent) transcript."
        },
        "is_meta": {
          "type": "boolean",
          "description": "The native line is marked meta."
        },
        "tool_use_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "description": "Secrets redacted. A tool input that is not an object is kept as {\"_raw\": text}."
        }
      }
    },
