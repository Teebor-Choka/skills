          "type": "string"
        },
        "session_id": {
          "type": ["string", "null"]
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Position in the export, starting at 0."
        },
        "uuid": {
          "type": ["string", "null"],
          "description": "Native line id, or null when the line has none. Blocks of one line share it."
        },
        "parent_uuid": {
          "type": ["string", "null"]
        },
        "timestamp": {
          "type": ["string", "null"]
        },
        "kind": {
          "const": "tool_call"
        },
        "block_index": {
          "type": "integer",
          "minimum": 0,
