          "description": "The native line is from a sidechain (subagent) transcript."
        },
        "is_meta": {
          "type": "boolean",
          "description": "The native line is marked meta."
        },
        "subtype": {
          "type": ["string", "null"],
          "description": "Native subtype. \"unknown-line\" marks a native line type the adapter does not know; content is only its type name."
        },
        "content": {
          "type": "string",
          "description": "Text. For tool_result, text blocks joined by newline, other block types become a placeholder."
        }
      }
    },
    {
      "title": "compaction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "harness",
        "session_id",
        "seq",
        "uuid",
        "parent_uuid",
        "timestamp",
        "kind",
        "block_index",
        "is_sidechain",
