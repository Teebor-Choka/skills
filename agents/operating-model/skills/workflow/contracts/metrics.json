{
  "port": "Metrics",
  "operations": {
    "observe": {
      "name": "observe",
      "input": {
        "type": "object",
        "properties": {
          "observation_id": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        },
        "required": ["observation_id", "metric", "value"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "recorded": {
            "type": "boolean"
          }
        },
        "required": ["recorded"],
        "additionalProperties": false
      },
      "requirements": {
        "lifetime": "returns within the caller's step timeout"
      },
      "guarantees": ["idempotent", "durable", "unknown-refused"],
      "errors": ["invalid-input", "unknown-metric"],
      "metrics": []
    },
    "query": {
      "name": "query",
      "input": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string"
          }
        },
        "required": ["metric"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "sum": {
            "type": "number"
          }
        },
        "required": ["metric", "count", "sum"],
        "additionalProperties": false
      },
      "requirements": {
        "lifetime": "returns within the caller's step timeout"
      },
      "guarantees": ["read-only"],
      "errors": ["invalid-input", "unknown-metric"],
      "metrics": []
    }
  },
  "notes": [
    "metric must be a name in the merged metric catalog. observation_id is the idempotency key of observe."
  ]
}
