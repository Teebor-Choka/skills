{
  "port": "Sessions",
  "operations": {
    "export": {
      "name": "export",
      "input": {
        "type": "object",
        "properties": {
          "harness": {
            "type": "string",
            "enum": ["claude-code", "codex", "opencode"]
          },
          "native": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant",
                    "thinking",
                    "tool_use",
                    "tool_result"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": ["type", "text"],
              "additionalProperties": false
            }
          }
        },
        "required": ["harness", "native"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "record": {
            "type": "object",
            "properties": {
              "harness": {
                "type": "string"
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": ["role", "text"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["harness", "messages"],
            "additionalProperties": false
          },
          "dropped_thinking": {
            "type": "integer"
          }
        },
        "required": ["record", "dropped_thinking"],
        "additionalProperties": false
      },
      "requirements": {
        "lifetime": "returns within the caller's step timeout"
      },
      "guarantees": ["idempotent", "thinking-dropped-counted"],
      "errors": ["invalid-input", "unsupported-format"],
      "metrics": []
    }
  },
  "notes": [
    "Thinking blocks are dropped from the record and counted in dropped_thinking.",
    "A harness whose format is not verified returns unsupported-format, never an empty record.",
    "The harness names codex and opencode are unverified: no conformance test exercises them.",
    "Slice types are a simplification of the session record kinds: user, assistant, thinking, tool_use and tool_result.",
    "No first-catalog metric (execution plan, Appendix A) is something these operations emit, so every metrics list is empty, and metrics emission is not tested."
  ]
}
