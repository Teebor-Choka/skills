{
  "port": "Channel",
  "operations": {
    "send": {
      "name": "send",
      "input": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          },
          "message_id": {
            "type": "string"
          },
          "sender": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": ["channel", "message_id", "sender", "text"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string"
          },
          "seq": {
            "type": "integer"
          },
          "duplicate": {
            "type": "boolean"
          }
        },
        "required": ["message_id", "seq", "duplicate"],
        "additionalProperties": false
      },
      "requirements": {
        "network": "reaches the adapter's backing service",
        "lifetime": "returns within the caller's step timeout"
      },
      "guarantees": ["idempotent", "durable"],
      "errors": ["invalid-input", "channel-unavailable"],
      "metrics": []
    },
    "subscribe": {
      "name": "subscribe",
      "input": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          },
          "after": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["channel"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seq": {
                  "type": "integer"
                },
                "message_id": {
                  "type": "string"
                },
                "sender": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": ["seq", "message_id", "sender", "text"],
              "additionalProperties": false
            }
          },
          "cursor": {
            "type": "integer"
          }
        },
        "required": ["messages", "cursor"],
        "additionalProperties": false
      },
      "requirements": {
        "network": "reaches the adapter's backing service",
        "lifetime": "returns within the caller's step timeout"
      },
      "guarantees": ["ordered", "read-only"],
      "errors": ["invalid-input", "channel-unavailable"],
      "metrics": []
    },
    "list-participants": {
      "name": "list-participants",
      "input": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          }
        },
        "required": ["channel"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["participants"],
        "additionalProperties": false
      },
      "requirements": {
        "network": "reaches the adapter's backing service",
        "lifetime": "returns within the caller's step timeout"
      },
      "guarantees": ["read-only"],
      "errors": ["invalid-input", "channel-unavailable"],
      "metrics": []
    }
  },
  "notes": [
    "Delivery is pull-based: subscribe returns the messages after a cursor, so any binding (terminal, GitHub comment, XMPP) can implement it.",
    "message_id is the idempotency key of send. A repeated id returns the first seq with duplicate true.",
    "No first-catalog metric (execution plan, Appendix A) is something these operations emit, so every metrics list is empty, and metrics emission is not tested."
  ]
}
