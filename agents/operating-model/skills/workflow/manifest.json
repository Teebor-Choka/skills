{
  "owner": "teebor",
  "namespace": "org",
  "roles": {
    "lead": {
      "escalates-to": "owner",
      "may-spawn": ["worker", "reviewer", "tester", "ci", "architect", "pm"]
    },
    "pm": {
      "escalates-to": "lead"
    },
    "tester": {
      "escalates-to": "lead"
    },
    "ci": {
      "escalates-to": "lead"
    },
    "architect": {
      "escalates-to": "lead"
    },
    "reviewer": {
      "escalates-to": "lead"
    },
    "worker": {
      "escalates-to": "lead"
    },
    "improver": {
      "escalates-to": "owner"
    }
  },
  "workflows": {
    "sw-development": {
      "path": "workflows/sw-development.yaml",
      "floors": ["spec", "review", "merge-gate"]
    },
    "tdd-unit": {
      "path": "workflows/tdd-unit.yaml",
      "floors": []
    },
    "improve": {
      "path": "workflows/improve.yaml",
      "floors": []
    },
    "bug": {
      "path": "workflows/bug.yaml",
      "floors": ["reproduce-evidence", "review", "merge-gate"]
    },
    "improvement-scan": {
      "path": "workflows/improvement-scan.yaml",
      "floors": []
    }
  },
  "targets": {
    "spec-rework": {
      "at-most": 1,
      "per": "item"
    },
    "red-for-wrong-reason": {
      "at-most": 0,
      "per": "unit"
    },
    "acceptance-coverage": {
      "at-least": 1.0
    }
  },
  "vetoes": [
    "no merge without the merge-gate decision",
    "no node weakens a floor, a target or a criteria file"
  ]
}
